---
export const prerender = false

import { auth } from "@/lib/auth"
import OnboardingLayout from "@/layouts/onboarding-layout.astro"

if (!Astro.locals.session || !Astro.locals.user) {
  return Astro.redirect("/login")
}

const organizations = await auth.api.listOrganizations({ headers: Astro.request.headers })
if (organizations?.length) {
  return Astro.redirect("/app")
}
---

<OnboardingLayout
  title="Buat bisnis Anda | QR"
  description="Siapkan bisnis Anda di QR."
/>
