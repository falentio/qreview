---
export const prerender = false

import AppLayout from "@/layouts/app-layout.astro"
import { QrCodeList } from "@/components/app/qr-code-list"
---

<AppLayout title="Kode QR yang diarsipkan" description="Pulihkan kode QR yang diarsipkan dari bisnis Anda.">
  <div class="flex flex-1 flex-col gap-6 p-4 pt-0 md:p-6 md:pt-0">
    <div class="flex flex-col gap-2 pt-2">
      <p class="text-sm font-medium text-muted-foreground">Kode QR</p>
      <h1 class="text-3xl font-semibold tracking-tight">Kode QR yang diarsipkan</h1>
      <p class="max-w-2xl text-muted-foreground">
        Tinjau kode QR yang diarsipkan dari bisnis aktif Anda dan pulihkan saat siap digunakan kembali.
      </p>
    </div>
    <QrCodeList view="archived" client:only="react" />
  </div>
</AppLayout>
