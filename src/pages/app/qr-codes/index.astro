---
export const prerender = false

import AppLayout from "@/layouts/app-layout.astro"
import { QrCodeList } from "@/components/app/qr-code-list"
---

<AppLayout title="QR codes" description="Manage QR codes for your business.">
  <div class="flex flex-1 flex-col gap-6 p-4 pt-0 md:p-6 md:pt-0">
    <div class="flex flex-col gap-2 pt-2">
      <p class="text-sm font-medium text-muted-foreground">QR codes</p>
      <h1 class="text-3xl font-semibold tracking-tight">QR codes</h1>
      <p class="max-w-2xl text-muted-foreground">
        View the QR codes assigned to your active business, their destinations, and their expiry
        dates.
      </p>
    </div>
    <QrCodeList client:only="react" />
  </div>
</AppLayout>
