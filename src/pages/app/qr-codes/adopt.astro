---
export const prerender = false

import AppLayout from "@/layouts/app-layout.astro"
import { QrAdoptionForm } from "@/components/app/qr-adoption-form"
---

<AppLayout title="Adopt a QR code" description="Assign an unclaimed QR code to your business.">
  <div class="flex flex-1 flex-col gap-6 p-4 pt-0 md:p-6 md:pt-0">
    <div class="flex flex-col gap-2 pt-2">
      <p class="text-sm font-medium text-muted-foreground">QR codes</p>
      <h1 class="text-3xl font-semibold tracking-tight">Adopt a QR code</h1>
      <p class="max-w-2xl text-muted-foreground">
        Scan or upload a QR code from your business kit to assign it to the active business workspace.
      </p>
    </div>
    <QrAdoptionForm client:only="react" />
  </div>
</AppLayout>
