---
export const prerender = false

import AppLayout from "@/layouts/app-layout.astro"
import { QrAdoptionForm } from "@/components/app/qr-adoption-form"
---

<AppLayout title="Klaim kode QR" description="Tetapkan kode QR yang belum diklaim ke bisnis Anda.">
  <div class="flex flex-1 flex-col gap-6 p-4 pt-0 md:p-6 md:pt-0">
    <div class="flex flex-col gap-2 pt-2">
      <p class="text-sm font-medium text-muted-foreground">Kode QR</p>
      <h1 class="text-3xl font-semibold tracking-tight">Klaim kode QR</h1>
      <p class="max-w-2xl text-muted-foreground">
        Pindai atau unggah kode QR dari kit bisnis Anda untuk menetapkannya ke ruang kerja bisnis aktif.
      </p>
    </div>
    <QrAdoptionForm client:only="react" />
  </div>
</AppLayout>
