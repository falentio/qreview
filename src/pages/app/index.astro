---
export const prerender = false

import AppLayout from "@/layouts/app-layout.astro"
import { QrAnalyticsDashboard } from "@/components/app/qr-analytics-dashboard"

---

<AppLayout title="Ringkasan" description="Pahami aktivitas pengalihan di seluruh kode QR Anda.">
  <div class="flex flex-1 flex-col gap-6 p-4 pt-0 md:p-6 md:pt-0">
    <div class="flex flex-col gap-2 pt-2">
      <p class="text-sm font-medium text-muted-foreground">Ruang kerja Anda</p>
      <h1 class="text-3xl font-semibold tracking-tight">Ringkasan</h1>
      <p class="max-w-2xl text-muted-foreground">
        Lihat seberapa sering kode QR Anda mengarahkan pelanggan ke tempat yang tepat.
      </p>
    </div>
    <QrAnalyticsDashboard client:only="react" />
  </div>
</AppLayout>
