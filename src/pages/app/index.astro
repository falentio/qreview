---
export const prerender = false

import AppLayout from "@/layouts/app-layout.astro"
import { QrAnalyticsDashboard } from "@/components/app/qr-analytics-dashboard"

---

<AppLayout title="Overview" description="Understand redirect activity across your QR codes.">
  <div class="flex flex-1 flex-col gap-6 p-4 pt-0 md:p-6 md:pt-0">
    <div class="flex flex-col gap-2 pt-2">
      <p class="text-sm font-medium text-muted-foreground">Your workspace</p>
      <h1 class="text-3xl font-semibold tracking-tight">Overview</h1>
      <p class="max-w-2xl text-muted-foreground">
        See how often your QR codes send customers to the right place.
      </p>
    </div>
    <QrAnalyticsDashboard client:only="react" />
  </div>
</AppLayout>
