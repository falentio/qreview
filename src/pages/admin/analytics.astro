---
export const prerender = false

import AdminLayout from "@/layouts/admin-layout.astro"
import { QrAnalyticsFillForm } from "@/components/admin/qr-analytics-fill-form"
---

<AdminLayout title="Isi data analitik" description="Isi data analitik QR per jam untuk pengujian dan persiapan.">
  <div class="flex flex-1 flex-col gap-6 p-4 pt-0 md:p-6 md:pt-0">
    <div class="flex flex-col gap-2 pt-2">
      <p class="text-sm font-medium text-muted-foreground">Analitik platform</p>
      <h1 class="text-3xl font-semibold tracking-tight">Isi data analitik</h1>
      <p class="max-w-2xl text-muted-foreground">
        Isi data upaya pengalihan per jam untuk kode QR yang sudah ada. Halaman ini dibatasi untuk
        admin global dan ditujukan untuk data pengujian serta persiapan dasbor.
      </p>
    </div>
    <QrAnalyticsFillForm client:only="react" />
  </div>
</AdminLayout>
