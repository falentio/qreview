---
export const prerender = false

import { QrBatchCreateForm } from "@/components/admin/qr-batch-create-form"
import AdminLayout from "@/layouts/admin-layout.astro"
---

<AdminLayout title="Buat batch kode QR" description="Buat data kode QR yang belum diklaim untuk ditetapkan nanti.">
  <div class="flex flex-1 flex-col gap-6 p-4 pt-0 md:p-6 md:pt-0">
    <div class="flex flex-col gap-2 pt-2">
      <p class="text-sm font-medium text-muted-foreground">Kode QR</p>
      <h1 class="text-3xl font-semibold tracking-tight">Buat batch kode QR</h1>
      <p class="max-w-2xl text-muted-foreground">
        Buat data kode QR yang belum diklaim tanpa menetapkan organisasi. Setiap data yang dikembalikan
        dapat diubah menjadi gambar di browser setelahnya.
      </p>
    </div>
    <QrBatchCreateForm client:load />
  </div>
</AdminLayout>
