---
export const prerender = false

import AdminLayout from "@/layouts/admin-layout.astro"
---

<AdminLayout title="QR codes" description="Create and manage platform QR codes.">
  <div class="flex flex-1 flex-col gap-6 p-4 pt-0 md:p-6 md:pt-0">
    <div class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-end sm:justify-between">
      <div class="flex flex-col gap-2">
        <p class="text-sm font-medium text-muted-foreground">Platform QR codes</p>
        <h1 class="text-3xl font-semibold tracking-tight">QR codes</h1>
        <p class="max-w-2xl text-muted-foreground">
          Generate unclaimed QR records in batches, then assign them to organizations and prepare
          their images in the browser.
        </p>
      </div>
      <a
        href="/admin/qr-codes/new"
        class="inline-flex h-9 shrink-0 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/80"
      >
        Create QR batch
      </a>
    </div>

    <section class="flex min-h-72 flex-1 flex-col items-center justify-center rounded-xl border border-dashed bg-muted/20 p-8 text-center">
      <div class="flex size-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
        <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 3h6v6H3zM15 3h6v6h-6zM3 15h6v6H3zM15 15h2v2h-2zM19 15h2v6h-6v-2h4zM11 11h2v2h-2zM15 11h2v2h-2zM11 15h2v6h-2z" />
        </svg>
      </div>
      <h2 class="mt-4 text-lg font-semibold">Create a QR batch</h2>
      <p class="mt-1 max-w-md text-sm text-muted-foreground">
        Start with a destination and number of records. Organization assignment happens later when
        a code is claimed.
      </p>
      <a
        href="/admin/qr-codes/new"
        class="mt-5 inline-flex h-9 items-center justify-center rounded-lg border border-border bg-background px-4 text-sm font-medium transition-colors hover:bg-muted"
      >
        Open batch form
      </a>
    </section>
  </div>
</AdminLayout>
