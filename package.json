{
  "name": "",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev --env-file .dev.vars",
    "build": "alchemy plan --env-file .dev.vars",
    "preview": "alchemy dev --env-file .dev.vars",
    "astro": "astro",
    "deploy": "alchemy deploy",
    "plan": "alchemy plan --env-file .dev.vars",
    "destroy": "alchemy destroy",
    "backfill-qr-public-projection": "vp exec tsx scripts/backfill-qr-public-projection.ts",
    "auth:generate": "auth generate --adapter drizzle --dialect sqlite --output ./src/db/auth-schema.ts --yes && vp exec tsx scripts/normalize-auth-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:up": "drizzle-kit up",
    "test": "vp test",
    "test:integration": "vp test --config vitest.integration.config.ts",
    "test:watch": "vp test watch",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@base-ui/react": "^1.7.0",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@logtape/logtape": "^2.3.2",
    "@logtape/redaction": "^2.3.2",
    "@orpc/client": "^1.15.0",
    "@orpc/contract": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.8",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.34.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^2.12.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.74",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@effect/platform-node": "4.0.0-rc.112",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "alchemy": "2.0.0-beta.74",
    "auth": "^1.7.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "effect": "4.0.0-rc.112",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9",
    "vitest-mock-extended": "^5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
