{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "qr",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qr",
      // Replace this local placeholder with the ID from `wrangler d1 create qr`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./drizzle",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "PLACES_CACHE",
      // Replace this local placeholder with the ID from `wrangler kv namespace create PLACES_CACHE`.
      "id": "00000000000000000000000000000000",
    },
    {
      "binding": "QR_PUBLIC_PROJECTION",
      // Replace this local placeholder with the ID from `wrangler kv namespace create QR_PUBLIC_PROJECTION`.
      "id": "11111111111111111111111111111111",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
